# Supabase — Project Settings > API
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — server-only, NEVER expose to the browser. Used by /admin
# and the checkout API routes to bypass RLS for writes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Password for the /admin product panel — pick something you don't reuse elsewhere.
ADMIN_PASSWORD=change-me

# Shiprocket — Settings > API > Add New API User (use a separate email from
# your main login). SHIPROCKET_PICKUP_LOCATION is the exact nickname you gave
# your pickup address under Settings > Pickup Addresses.
SHIPROCKET_EMAIL=your-api-user@example.com
SHIPROCKET_PASSWORD=your-shiprocket-api-password
SHIPROCKET_PICKUP_LOCATION=Primary

# Razorpay — Dashboard > Settings > API Keys
# Key ID is safe to expose to the browser; the Key Secret must stay server-only.
PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-secret-key
